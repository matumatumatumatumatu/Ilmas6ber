<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ilmas6ber.LoginPage"
             Title="LoginPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <!-- Logo -->
            <Frame
                HeightRequest="100"
                WidthRequest="100"
                CornerRadius="50"
                BackgroundColor="#4F46E5"
                HorizontalOptions="Center"
                BorderColor="Transparent">

                <Label
                    Text="🔐"
                    FontSize="40"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>
            </Frame>

            <!-- Title -->
            <Label
                Text="Welcome Back"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#1F2937"/>

            <Label
                Text="Login or create a new account"
                FontSize="14"
                HorizontalOptions="Center"
                TextColor="#6B7280"/>

            <!-- Tabs -->
            <Grid ColumnDefinitions="*,*">
                <Button
                    x:Name="LoginTabButton"
                    Grid.Column="0"
                    Text="Login"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnLoginTabClicked"/>

                <Button
                    x:Name="SignUpTabButton"
                    Grid.Column="1"
                    Text="Sign Up"
                    BackgroundColor="#E5E7EB"
                    TextColor="#374151"
                    CornerRadius="10"
                    Clicked="OnSignUpTabClicked"/>
            </Grid>

            <!-- Error Label -->
            <Label
                x:Name="ErrorLabel"
                Text=""
                TextColor="#EF4444"
                FontSize="14"
                HorizontalOptions="Center"
                IsVisible="False"/>

            <!-- Full Name (Signup only) -->
            <Entry
                x:Name="FullNameEntry"
                Placeholder="Full Name"
                HeightRequest="50"
                BackgroundColor="White"
                Margin="0,10,0,0"
                IsVisible="False"/>

            <!-- Email -->
            <Entry
                x:Name="EmailEntry"
                Placeholder="Email Address"
                Keyboard="Email"
                HeightRequest="50"
                BackgroundColor="White"/>

            <!-- Password -->
            <Entry
                x:Name="PasswordEntry"
                Placeholder="Password"
                IsPassword="True"
                HeightRequest="50"
                BackgroundColor="White"/>

            <!-- Confirm Password (Signup only) -->
            <Entry
                x:Name="ConfirmPasswordEntry"
                Placeholder="Confirm Password"
                IsPassword="True"
                HeightRequest="50"
                BackgroundColor="White"
                IsVisible="False"/>

            <!-- Remember Me -->
            <Grid ColumnDefinitions="Auto,*">
                <CheckBox
                    x:Name="RememberMeCheckBox"
                    Grid.Column="0"
                    IsChecked="True"/>

                <Label
                    Grid.Column="1"
                    Text="Remember Me"
                    VerticalOptions="Center"
                    TextColor="#4B5563"/>
            </Grid>

            <!-- Primary Button -->
            <Button
                x:Name="ContinueButton"
                Text="Login"
                HeightRequest="55"
                CornerRadius="12"
                BackgroundColor="#4F46E5"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnContinueClicked"/>

            <!-- Loading Indicator -->
            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False"
                Color="#4F46E5"
                HorizontalOptions="Center"/>

            <!-- Divider -->
            <Grid ColumnDefinitions="*,Auto,*">
                <BoxView
                    Grid.Column="0"
                    HeightRequest="1"
                    VerticalOptions="Center"
                    Color="#D1D5DB"/>

                <Label
                    Grid.Column="1"
                    Text="  OR  "
                    TextColor="#6B7280"/>

                <BoxView
                    Grid.Column="2"
                    HeightRequest="1"
                    VerticalOptions="Center"
                    Color="#D1D5DB"/>
            </Grid>

            <!-- Social Login -->
            <Button
                Text="Continue with Google"
                BackgroundColor="White"
                BorderColor="#D1D5DB"
                BorderWidth="1"
                TextColor="#374151"
                CornerRadius="12"/>

            <Button
                Text="Continue with Apple"
                BackgroundColor="Black"
                TextColor="White"
                CornerRadius="12"/>

            <!-- Footer -->
            <HorizontalStackLayout
                x:Name="FooterStack"
                HorizontalOptions="Center"
                Spacing="5">

                <Label
                    x:Name="FooterLabel"
                    Text="Don't have an account?"
                    TextColor="#6B7280"/>

                <Label
                    x:Name="FooterActionLabel"
                    Text="Sign Up"
                    TextColor="#4F46E5"
                    FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFooterActionTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>