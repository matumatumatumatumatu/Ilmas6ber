<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ilmas6ber.MainPage">

    <Grid x:Name="MapGrid" RowDefinitions="*" ColumnDefinitions="*">

        <!-- Bottom-Right Zoom Button Overlay -->
        <Grid x:Name="ZoomButtonOverlayBottomRight" 
              Grid.Row="0"
              Grid.Column="0"
              Padding="20,20,20,20" 
              ColumnDefinitions="Auto,Auto"
              RowDefinitions="Auto,Auto"
              HorizontalOptions="End"
              VerticalOptions="End">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTappedBottomRight" />
            </Grid.GestureRecognizers>

            <Button x:Name="ZoomInButtonBottomRight" 
                    Grid.Row="0" Grid.Column="0"
                    Text="+" FontSize="24" FontAttributes="Bold"
                    CornerRadius="8" Padding="12"
                    BackgroundColor="#2c2d30" TextColor="White"
                    Clicked="OnZoomInClicked"
                    WidthRequest="60" HeightRequest="60"
                    Margin="0,0,8,8" Opacity="0" IsEnabled="False"/>

            <Button x:Name="ZoomOutButtonBottomRight" 
                    Grid.Row="1" Grid.Column="0"
                    Text="−" FontSize="24" FontAttributes="Bold"
                    CornerRadius="8" Padding="12"
                    BackgroundColor="#2c2d30" TextColor="White"
                    Clicked="OnZoomOutClicked"
                    WidthRequest="60" HeightRequest="60"
                    Margin="0,8,8,0" Opacity="0" IsEnabled="False"/>

            <Button x:Name="ZoomButtonBottomRight" 
                    Grid.Row="1" Grid.Column="1"
                    Text="🔍" FontSize="24"
                    CornerRadius="8" Padding="12"
                    BackgroundColor="#2c2d30" TextColor="White"
                    Clicked="OnZoomButtonClickedBottomRight"
                    WidthRequest="60" HeightRequest="60"/>

            <Button x:Name="FilterButton" 
                    Grid.Row="0" Grid.Column="0"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,120,16,0"
                    Text="🔽"
                    FontSize="24"
                    CornerRadius="8"
                    Padding="12"
                    BackgroundColor="#2c2d30"
                    TextColor="White"
                    Clicked="OnFilterButtonClicked"
                    WidthRequest="60"
                    HeightRequest="60"/>

        </Grid>

        
        <Button x:Name="ToggleMapLayer1"
                Grid.Row="0" Grid.Column="0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,50,16,0"
                Text="🛰️"
                FontSize="24"
                CornerRadius="8"
                Padding="12"
                BackgroundColor="#2c2d30"
                TextColor="White"
                Clicked="OnToggleMapClicked"
                WidthRequest="60"
                HeightRequest="60"/>

    </Grid>

</ContentPage>